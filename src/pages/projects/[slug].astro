---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { projects } from '../../data/projects';
import { image } from '../../data/images';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, next } = Astro.props;

// SVG diagrams are served straight from public/; raster images go through
// the build-time resize and WebP pipeline.
const isVector = project.hero.endsWith('.svg');
const hero = isVector ? null : image(project.hero);

// Full-resolution sources for the expanded view. SVG is already resolution
// independent; raster diagrams get one large WebP rendition so the lightbox
// stays legible when someone is actually trying to read the diagram.
const heroFull = isVector
  ? project.hero
  : (await getImage({ src: hero!, width: 2400, format: 'webp' })).src;

const shotsFull = await Promise.all(
  project.shots.map(async (shot) => ({
    ...shot,
    full: (await getImage({ src: image(shot.src), width: 2000, format: 'webp' })).src,
  }))
);
---

<Base
  title={`${project.title} · ${site.name}`}
  description={project.tagline}
  backLink={{ href: '/#work', label: 'All work' }}
>
  <!-- ==================== HEADER ==================== -->
  <article>
    <header class="border-b border-line pt-32 pb-16 sm:pt-40 sm:pb-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="eyebrow animate-[fadeUp_0.7s_cubic-bezier(0.16,1,0.3,1)_both]">
          Case study · {project.year}
        </p>

        <h1
          class="mt-5 max-w-4xl text-[clamp(2.25rem,6.5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.04em] animate-[fadeUp_0.8s_cubic-bezier(0.16,1,0.3,1)_0.08s_both]"
        >
          {project.title}
        </h1>

        <p
          class="mt-6 max-w-2xl text-lg leading-relaxed text-muted animate-[fadeUp_0.8s_cubic-bezier(0.16,1,0.3,1)_0.16s_both]"
        >
          {project.tagline}
        </p>

        <div class="mt-10 animate-[fadeUp_0.8s_cubic-bezier(0.16,1,0.3,1)_0.24s_both]">
          <a
            href={project.repo}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-2.5 rounded-full border border-line-hi px-5 py-2.5 text-sm transition-colors duration-300 hover:border-accent hover:text-accent"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            View source
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
              class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >
              <path d="M7 17L17 7M8 7h9v9" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- ==================== FACTS STRIP ==================== -->
    <div class="border-b border-line">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-2 gap-px bg-line lg:grid-cols-4">
          {
            project.facts.map((fact, i) => (
              <div data-reveal style={`--reveal-delay:${i * 60}ms`} class="bg-ink px-4 py-7 sm:px-6">
                <dt class="eyebrow">{fact.label}</dt>
                <dd class="mt-2.5 font-mono text-sm text-fg">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- ==================== ARCHITECTURE ==================== -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <figure data-reveal>
          <button
            type="button"
            data-lightbox
            data-full={heroFull}
            data-alt={project.heroAlt}
            data-caption="Architecture overview"
            class="group relative block w-full cursor-zoom-in overflow-hidden rounded-lg border border-line bg-surface p-3 text-left transition-colors duration-500 hover:border-line-hi sm:p-6"
            aria-label="Expand the architecture diagram"
          >
            {
              hero ? (
                <Image
                  src={hero}
                  alt={project.heroAlt}
                  widths={[760, 1200, 1600]}
                  sizes="(min-width: 1024px) 1100px, 92vw"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="mx-auto w-full rounded"
                />
              ) : (
                <img
                  src={project.hero}
                  alt={project.heroAlt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="mx-auto w-full rounded"
                />
              )
            }

            <span class="pointer-events-none absolute right-5 top-5 flex items-center gap-2 rounded-full border border-line bg-ink/80 px-3 py-1.5 font-mono text-[0.65rem] tracking-wide text-muted opacity-0 backdrop-blur transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
              </svg>
              Expand
            </span>
          </button>
          <figcaption class="mt-4 font-mono text-xs text-faint">
            {isVector ? 'Architecture overview' : 'Architecture overview. Full resolution in the repository.'}
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ==================== PROBLEM ==================== -->
    <section class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <h2 data-reveal class="eyebrow lg:col-span-3">The problem</h2>
          <div data-reveal style="--reveal-delay:80ms" class="lg:col-span-9">
            <p class="max-w-3xl text-[1.15rem] leading-relaxed text-fg sm:text-[1.3rem]">
              {project.problem}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== APPROACH ==================== -->
    <section class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <h2 data-reveal class="eyebrow lg:col-span-3">How it works</h2>
          <div data-reveal style="--reveal-delay:80ms" class="lg:col-span-9">
            <ol class="max-w-3xl space-y-7">
              {
                project.approach.map((step, i) => (
                  <li class="flex gap-5">
                    <span class="mt-1 shrink-0 font-mono text-xs text-accent">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <p class="text-[1.02rem] leading-relaxed text-muted" set:html={step} />
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== DECISIONS ==================== -->
    <section class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div data-reveal class="lg:col-span-3">
            <h2 class="eyebrow">Key decisions</h2>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-faint">
              The choices that shaped this, and what each one cost.
            </p>
          </div>

          <div class="lg:col-span-9">
            <ul class="space-y-px overflow-hidden rounded-lg border border-line bg-line">
              {
                project.decisions.map((d, i) => (
                  <li data-reveal style={`--reveal-delay:${i * 60}ms`} class="group bg-ink p-6 transition-colors duration-500 hover:bg-surface sm:p-8">
                    <h3 class="flex items-start gap-3 text-base font-medium text-fg sm:text-lg">
                      <span class="mt-2 h-px w-4 shrink-0 bg-accent transition-[width] duration-500 group-hover:w-7" />
                      {d.title}
                    </h3>
                    <ul class="mt-4 space-y-2 sm:pl-7">
                      {
                        d.points.map((point) => (
                          <li class="relative pl-5 text-[0.95rem] leading-relaxed text-muted">
                            <span class="absolute left-0 top-[0.7em] h-px w-2.5 bg-line-hi" aria-hidden="true" />
                            <span set:html={point} />
                          </li>
                        ))
                      }
                    </ul>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SHOTS ==================== -->
    {
      project.shots.length > 0 && (
        <section class="border-t border-line py-20 sm:py-28">
          <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <h2 data-reveal class="eyebrow">In operation</h2>
            <div class="mt-10 grid gap-8 sm:grid-cols-2">
              {shotsFull.map((shot, i) => (
                <figure
                  data-reveal
                  style={`--reveal-delay:${i * 80}ms`}
                  class={shot.wide ? 'sm:col-span-2' : ''}
                >
                  <button
                    type="button"
                    data-lightbox
                    data-full={shot.full}
                    data-alt={shot.caption}
                    data-caption={shot.caption}
                    class="block w-full cursor-zoom-in overflow-hidden rounded-lg border border-line bg-surface transition-colors duration-500 hover:border-line-hi"
                    aria-label={`Expand: ${shot.caption}`}
                  >
                    <Image
                      src={image(shot.src)}
                      alt={shot.caption}
                      widths={[560, 900, 1400]}
                      sizes={shot.wide ? '(min-width: 640px) 1100px, 92vw' : '(min-width: 640px) 540px, 92vw'}
                      loading="lazy"
                      decoding="async"
                      class="w-full"
                    />
                  </button>
                  <figcaption class="mt-3 font-mono text-xs text-faint">{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ==================== STACK + LIMITATIONS ==================== -->
    <section class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-14 lg:grid-cols-2 lg:gap-16">
          <div data-reveal>
            <h2 class="eyebrow">Stack</h2>
            <ul class="mt-6 flex flex-wrap gap-2">
              {project.stack.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>

          <div data-reveal style="--reveal-delay:80ms">
            <h2 class="eyebrow">Known limitations</h2>
            <div class="prose-tech mt-6">
              <ul>
                {project.limitations.map((l) => <li set:html={l} />)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== NEXT ==================== -->
    <nav class="border-t border-line" aria-label="Next project">
      <a href={`/projects/${next.slug}/`} class="group block py-16 sm:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <p class="eyebrow">Next case study</p>
          <div class="mt-4 flex items-center justify-between gap-6">
            <h2 class="text-[clamp(1.5rem,5vw,3rem)] font-medium tracking-[-0.04em] transition-colors duration-300 group-hover:text-accent">
              {next.title}
            </h2>
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              class="shrink-0 text-muted transition-[transform,color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-2 group-hover:text-accent"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
    </nav>
  </article>

  <Lightbox />
</Base>

<style is:global>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
