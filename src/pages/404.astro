---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Not found · ${site.name}`} description="That page doesn’t exist.">
  <section class="flex min-h-[80svh] items-center">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-5 text-[clamp(2.5rem,8vw,5rem)] font-medium leading-none tracking-[-0.045em]">
        No route to host.
      </h1>
      <p class="mt-6 max-w-md text-muted">
        That page doesn’t exist, or it was torn down along with the environment it described.
      </p>
      <a
        href="/"
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 text-sm font-medium text-ink transition-colors duration-300 hover:bg-accent"
      >
        Back to the homepage
      </a>
    </div>
  </section>
</Base>
