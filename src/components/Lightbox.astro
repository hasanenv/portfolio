---
// Full-screen image viewer. Opens in place rather than navigating, so the
// visitor keeps their scroll position and their place in the page.
//
// Any element with [data-lightbox] and a data-full attribute opens it.
---

<div
  data-lightbox-overlay
  class="pointer-events-none fixed inset-0 z-[90] flex items-center justify-center bg-ink/95 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-300 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Expanded image"
  hidden
>
  <button
    type="button"
    data-lightbox-close
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface/80 text-muted transition-colors duration-300 hover:border-accent hover:text-accent sm:right-8 sm:top-8"
    aria-label="Close expanded image"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </button>

  <figure class="flex max-h-full w-full max-w-7xl flex-col items-center gap-4">
    <img
      data-lightbox-image
      src=""
      alt=""
      class="max-h-[82vh] w-auto max-w-full rounded-lg object-contain"
    />
    <figcaption data-lightbox-caption class="px-4 text-center font-mono text-xs text-faint"></figcaption>
  </figure>

  <p class="absolute bottom-5 left-1/2 -translate-x-1/2 font-mono text-[0.65rem] tracking-wide text-faint">
    Press Esc or click anywhere to close
  </p>
</div>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
  const frame = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  if (overlay && frame && caption && closeBtn) {
    let lastFocused: HTMLElement | null = null;

    const open = (src: string, alt: string, text: string) => {
      lastFocused = document.activeElement as HTMLElement;
      frame.src = src;
      frame.alt = alt;
      caption.textContent = text;

      overlay.hidden = false;
      // Force a reflow so the browser registers the hidden state before the
      // transition starts. Doing this synchronously rather than in
      // requestAnimationFrame matters: rAF does not fire while the document
      // is hidden, which would leave the overlay open but invisible.
      void overlay.offsetHeight;
      overlay.classList.remove('opacity-0', 'pointer-events-none');

      // Compensate for the scrollbar so the page behind does not shift.
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      if (gap > 0) document.body.style.paddingRight = `${gap}px`;

      closeBtn.focus();
    };

    const close = () => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';

      window.setTimeout(() => {
        overlay.hidden = true;
        frame.src = '';
      }, 300);

      // Return focus to whatever opened it, so the reader keeps their place.
      lastFocused?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.dataset.full;
        if (!src) return;
        open(src, trigger.dataset.alt ?? '', trigger.dataset.caption ?? '');
      });
    });

    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => {
      // Clicking the image itself should not close it.
      if (e.target !== frame) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
      // Keep tab focus inside the dialog while it is open.
      if (e.key === 'Tab' && !overlay.hidden) {
        e.preventDefault();
        closeBtn.focus();
      }
    });
  }
</script>
