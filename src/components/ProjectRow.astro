---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { image } from '../data/images';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const flip = index % 2 === 1;
const n = String(index + 1).padStart(2, '0');

// Hand-drawn diagrams live in public/ as SVG: already tiny, resolution
// independent, and nothing for the image pipeline to usefully do to them.
const isVector = project.hero.endsWith('.svg');
const hero = isVector ? null : image(project.hero);
---

<article data-reveal class="group relative grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
  <!-- visual -->
  <a
    href={`/projects/${project.slug}/`}
    tabindex="-1"
    aria-hidden="true"
    class={`relative block overflow-hidden rounded-lg border border-line bg-surface transition-colors duration-500 group-hover:border-line-hi lg:col-span-7 ${
      flip ? 'lg:order-2 lg:col-start-6' : ''
    }`}
  >
    <div class="flex aspect-[4/3] w-full items-center justify-center p-4 sm:p-6">
      {
        hero ? (
          <Image
            src={hero}
            alt=""
            widths={[520, 760, 1040]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="lazy"
            decoding="async"
            class="max-h-full w-auto max-w-full object-contain opacity-75 transition-[transform,opacity] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02] group-hover:opacity-100"
          />
        ) : (
          <img
            src={project.hero}
            alt=""
            loading="lazy"
            decoding="async"
            class="max-h-full w-auto max-w-full object-contain opacity-75 transition-[transform,opacity] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02] group-hover:opacity-100"
          />
        )
      }
    </div>
    <div
      class="pointer-events-none absolute inset-0 rounded-lg ring-1 ring-inset ring-transparent transition-colors duration-500 group-hover:ring-accent/30"
    >
    </div>
  </a>

  <!-- copy -->
  <div class={`lg:col-span-5 ${flip ? 'lg:order-1 lg:col-start-1' : ''}`}>
    <div class="flex items-baseline gap-3">
      <span class="font-mono text-xs text-accent">{n}</span>
      <span class="eyebrow">{project.year}</span>
    </div>

    <h3 class="mt-3 text-2xl font-medium tracking-tight sm:text-3xl">
      <a href={`/projects/${project.slug}/`} class="transition-colors duration-300 group-hover:text-accent">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {project.title}
      </a>
    </h3>

    <p class="mt-4 text-[0.95rem] leading-relaxed text-muted">{project.blurb}</p>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
      {project.cardStack.map((t) => <li class="tag">{t}</li>)}
    </ul>

    <span
      class="mt-7 inline-flex items-center gap-2 font-mono text-xs tracking-wide text-muted transition-colors duration-300 group-hover:text-accent"
    >
      Read the case study
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        class="transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</article>
