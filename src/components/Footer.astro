---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-sm text-fg">{site.name}</p>
        <p class="mt-1 text-sm text-faint">
          {site.role} · {site.location}
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Elsewhere">
        <a href={site.github} rel="me noopener" target="_blank" class="ulink text-sm">GitHub</a>
        <a href={site.linkedin} rel="me noopener" target="_blank" class="ulink text-sm">LinkedIn</a>
        <a href={`mailto:${site.email}`} class="ulink text-sm">Email</a>
        {site.cv && <a href={site.cv} class="ulink text-sm">CV</a>}
      </nav>
    </div>

    <div class="rule my-8"></div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-faint">© {year} {site.name}</p>
    </div>
  </div>
</footer>
